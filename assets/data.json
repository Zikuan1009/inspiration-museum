    {
      "id": "q_calli_03",
      "text": "书，如也，如其学，如其才，如其志，总之曰如其人而已。",
      "author": "刘熙载，《艺概》",
      "theme": "书法"
    },
    {
      "id": "q_calli_04",
      "text": "书者，散也。欲书先散怀抱。",
      "author": "蔡邕，《笔论》",
      "theme": "书法"
    },
    {
