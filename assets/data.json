      "theme": "摄影"
    },
    {
      "id": "q_photo_02",
      "text": "Frame a scene so that something important sits just outside it.",
      "author": "Original prompt",
      "theme": "摄影"
    },
    {
      "id": "q_photo_03",
      "text": "Step closer until the background has to choose a side.",
