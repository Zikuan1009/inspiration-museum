  "quotes": [
    {
      "id": "q_music_01",
      "text": "Follow one instrument until the rest of the room falls away.",
      "author": "Original prompt",
      "theme": "音乐"
    },
    {
      "id": "q_music_02",
      "text": "Tap a rhythm, then leave out the beat you were about to play.",
      "author": "Original prompt",
      "theme": "音乐"
    },
    {
      "id": "q_music_03",
      "text": "Hold a single tone until you can hear the room answer it.",
      "author": "Original prompt",
      "theme": "音乐"
    },
    {
      "id": "q_music_04",
      "text": "Start a phrase and stop while it still has somewhere to go.",
      "author": "Original prompt",
      "theme": "音乐"
    },
    {
      "id": "q_music_05",
      "text": "Record the room before anyone begins, and keep that take.",
      "author": "Original prompt",
      "theme": "音乐"
    },
    {
      "id": "q_paint_01",
      "text": "Name the color that is missing, then work around its absence.",
      "author": "Original prompt",
      "theme": "绘画"
    },
    {
      "id": "q_paint_02",
      "text": "Put two colors side by side and write which one steps forward.",
      "author": "Original prompt",
      "theme": "绘画"
    },
    {
      "id": "q_paint_03",
      "text": "Leave a patch of the ground showing, and decide what it holds.",
      "author": "Original prompt",
      "theme": "绘画"
    },
    {
      "id": "q_paint_04",
      "text": "Draw the same edge three times and keep the hesitant one.",
      "author": "Original prompt",
      "theme": "绘画"
    },
    {
      "id": "q_arch_01",
      "text": "Stand in a doorway and notice what the frame cuts from the view.",
      "author": "Original prompt",
      "theme": "建筑"
    },
    {
      "id": "q_arch_02",
      "text": "Follow a shadow across the floor until it meets a wall.",
      "author": "Original prompt",
      "theme": "建筑"
    },
    {
      "id": "q_arch_03",
      "text": "Count the steps between two rooms and ask what that distance is for.",
      "author": "Original prompt",
      "theme": "建筑"
    },
    {
      "id": "q_arch_04",
      "text": "Find where daylight first enters, and stay there for a minute.",
      "author": "Original prompt",
      "theme": "建筑"
    },
    {
      "id": "q_mech_01",
      "text": "Watch one hinge through a full swing and note where it sticks.",
      "author": "Original prompt",
      "theme": "机械"
    },
    {
      "id": "q_mech_02",
      "text": "Trace a force from the handle in your hand down to the floor.",
      "author": "Original prompt",
      "theme": "机械"
    },
    {
      "id": "q_mech_03",
      "text": "Take one moving part and ask what would happen if it moved less.",
      "author": "Original prompt",
      "theme": "机械"
    },
    {
      "id": "q_mech_04",
      "text": "Listen to a machine idling and separate the sounds that mean work.",
      "author": "Original prompt",
      "theme": "机械"
    },
    {
      "id": "q_lit_01",
      "text": "Write one sentence that could open a room you have not entered.",
      "author": "Original prompt",
      "theme": "文学"
    },
    {
      "id": "q_lit_02",
      "text": "Copy a line from today and remove every word that explains it.",
      "author": "Original prompt",
      "theme": "文学"
    },
    {
      "id": "q_lit_03",
      "text": "Describe an object as if it had just learned your name.",
      "author": "Original prompt",
      "theme": "文学"
    },
    {
      "id": "q_lit_04",
      "text": "Stop the paragraph one sentence before it becomes tidy.",
      "author": "Original prompt",
      "theme": "文学"
    },
    {
      "id": "q_photo_01",
      "text": "Wait until the light moves, then make the picture you did not plan.",
