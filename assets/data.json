      "theme": "科学"
    },
    {
      "id": "q_calli_01",
      "text": "一点成一字之规，一字乃终篇之准。",
      "author": "孙过庭，《书谱》",
      "theme": "书法"
    },
    {
      "id": "q_calli_02",
      "text": "察之者尚精，拟之者贵似。",
      "author": "孙过庭，《书谱》",
      "theme": "书法"
