# Example only. Do not put real keys in this file.
# The Flutter app does not read this file.
#
# Supabase injects these into Edge Functions automatically:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#
# Set the two keys below as Edge Function secrets:
#   supabase secrets set NEBIUS_API_KEY=... FAL_KEY=...

NEBIUS_API_KEY=replace-with-nebius-token-factory-key
FAL_KEY=replace-with-fal-key

# Optional, for the Supabase CLI on a developer machine.
# Never commit a real token.
SUPABASE_ACCESS_TOKEN=replace-with-a-personal-access-token
